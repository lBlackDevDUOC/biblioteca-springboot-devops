# ============================================================
# VARIABLES PARA DOCKER COMPOSE
# ============================================================
# Copia este archivo como .env y cambia los valores.
# El archivo .env no se sube al repositorio (.gitignore).
# En EC2 el pipeline crea el .env con los GitHub Secrets.

# Contraseña de PostgreSQL
POSTGRES_PASSWORD=cambiar-esta-clave

# Clave JWT en Base64 (mínimo 32 bytes), la misma para todos los microservicios
# Generar una nueva: openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-base64
